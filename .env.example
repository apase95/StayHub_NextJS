# Database
DB_NAME="stayhub_db"
DB_USERNAME="stayhub"
DB_PASSWORD="password"
DB_PORT=5432
DATABASE_URL="postgresql://stayhub:password@localhost:5432/stayhub_db"
DATABASE_URL_TEST="postgresql://stayhub:password@localhost:5432/stayhub_test_db"

# App
APP_PORT=3000
APP_LOCAL_URL="http://localhost:3000"
APP_SECRET="your-secret-here"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Gmail SMTP)
MAIL_ENABLED=true
MAIL_SYSTEM_NAME="StayHub"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME="your@gmail.com"
MAIL_PASSWORD="your-app-password"
MAIL_FROM="StayHub <noreply@stayhub.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# VNPay
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/payments/vnpay/return"
VNPAY_IPN_URL="http://localhost:3000/api/payments/vnpay/ipn"

# Upload
UPLOAD_USE_CLOUDINARY=false
UPLOAD_LOCAL_DIRECTORY="public/uploads"
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_REQUEST_SIZE=52428800
UPLOAD_MAX_IMAGES_PER_PROPERTY=10

# Admin bootstrap
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FULL_NAME="StayHub Admin"
